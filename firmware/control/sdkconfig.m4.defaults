# M4 semantic-protocol validation image: retain the Waveshare UI and lighting,
# disable the legacy local audio backend, and use USB Serial/JTAG for the
# development command console. Product UI migration is intentionally M5.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_SC_ENABLE_AUDIO is not set
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
