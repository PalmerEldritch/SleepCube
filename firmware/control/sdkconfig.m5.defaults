# M5 product-UI migration image: preserve the Waveshare display and lighting,
# replace its legacy local audio backend with the semantic Audio Controller
# facade, and keep USB Serial/JTAG available for validation logs.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_SC_ENABLE_AUDIO is not set
CONFIG_SC_AUDIO_REMOTE_LINK=y
CONFIG_SC_REMOTE_PLAY_DURATION_SECONDS=1800
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
