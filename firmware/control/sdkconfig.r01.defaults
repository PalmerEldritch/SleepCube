# SleepCube R01-development Control Controller COB-lighting profile.
# Audio remains owned by the separate Audio Controller and every normal PLAY
# request remains finite at 60 minutes.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SC_REMOTE_PLAY_DURATION_SECONDS=3600
# CONFIG_SC_ENABLE_SEMANTIC_CONSOLE is not set
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
CONFIG_SC_LIGHT_PWM_GPIO=8
CONFIG_SC_LIGHT_PWM_FREQUENCY_HZ=3000
CONFIG_SC_LIGHT_PWM_MIN_DUTY_PCT=5
CONFIG_SC_LIGHT_PWM_MAX_DUTY_PCT=80
# CONFIG_SC_TRACE_TIMING is not set
