# SleepCube R00 Control Controller release profile.
# Audio is owned by the separate Audio Controller and controlled only through
# the semantic UART facade. Every normal PLAY request is finite at 60 minutes.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SC_REMOTE_PLAY_DURATION_SECONDS=3600
# CONFIG_SC_ENABLE_SEMANTIC_CONSOLE is not set
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
CONFIG_SC_LED_MIN_SELECTED_BRIGHTNESS_PCT=26
CONFIG_SC_LED_MIN_EFFECTIVE_BRIGHTNESS_PCT=17
# CONFIG_SC_TRACE_TIMING is not set
