# M7 product UX/lighting integration image. Audio remains remote and every
# normal product PLAY carries the R00 30-minute finite duration.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_SC_ENABLE_AUDIO is not set
CONFIG_SC_AUDIO_REMOTE_LINK=y
CONFIG_SC_REMOTE_PLAY_DURATION_SECONDS=1800
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
