# M3 transport-only Control Controller image: retain UI and lighting, disable
# the legacy Waveshare-local audio backend while remote audio commands are absent.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_SC_ENABLE_AUDIO is not set
CONFIG_SC_ENABLE_LIGHT=y
CONFIG_SC_ENABLE_UI=y
